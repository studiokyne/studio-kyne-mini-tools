			path: includes/Modules/Security/HardeningService.php

		-
			message: '#^Property StudioKyne\\MiniTools\\Modules\\Security\\HardeningService\:\:\$hide_wp_version is never read, only written\.$#'
			identifier: property.onlyWritten
