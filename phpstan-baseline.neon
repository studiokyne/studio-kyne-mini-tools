		-
			message: '#^Method StudioKyne\\MiniTools\\Modules\\MenuCreator\\Module\:\:get_uninstall_keys\(\) should return array\{options\: array\<string\>, meta\: array\<string\>, user_meta\: array\<string\>\} but returns array\{options\: array\{''skmt_wl_menu…'', ''skmt_wl_menu_cache…''\}, meta\: array\{\}\}\.$#'
			identifier: return.type
			count: 1
