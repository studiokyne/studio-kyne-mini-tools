			count: 1
			path: includes/Admin/Admin.php

		-
			message: '#^Call to an undefined method StudioKyne\\MiniTools\\Core\\ModuleInterface\:\:import_extras\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: includes/Admin/Admin.php

		-
			message: '#^Call to an undefined method StudioKyne\\MiniTools\\Core\\ModuleInterface\:\:on_activate\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: includes/Core/Modules.php

		-
			message: '#^Call to an undefined method StudioKyne\\MiniTools\\Core\\ModuleInterface\:\:on_deactivate\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: includes/Core/Modules.php

		-
			message: '#^Method StudioKyne\\MiniTools\\Modules\\Database\\Module\:\:get_uninstall_keys\(\) should return array\{options\: array\<string\>, meta\: array\<string\>, user_meta\: array\<string\>\} but returns array\{options\: array\{\}, meta\: array\{\}\}\.$#'
