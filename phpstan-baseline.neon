		-
			message: '#^Found usage of constant DISALLOW_FILE_MODS\. Use wp_is_file_mod_allowed\(\) instead\.$#'
			identifier: phpstanWP.wpConstant.fetch
			count: 1
			path: includes/Modules/Files/Module.php

		-
			message: '#^Method StudioKyne\\MiniTools\\Modules\\Files\\Module\:\:get_uninstall_keys\(\) should return array\{options\: array\<string\>, meta\: array\<string\>, user_meta\: array\<string\>\} but returns array\{options\: array\{''skmt_module_files''\}, meta\: array\{\}\}\.$#'
			identifier: return.type
			count: 1
			path: includes/Modules/Files/Module.php

		-
			message: '#^Ternary operator condition is always true\.$#'
			identifier: ternary.alwaysTrue
			count: 1
			path: includes/Modules/ImageOptimizer/MediaLibrary.php

		-
			message: '#^Method StudioKyne\\MiniTools\\Modules\\ImageOptimizer\\Module\:\:get_uninstall_keys\(\) should return array\{options\: array\<string\>, meta\: array\<string\>, user_meta\: array\<string\>\} but returns array\{options\: array\{''skmt_module_image…'', ''skmt_module_image…'', ''skmt_module_image…''\}, meta\: array\{''_skmt_optimized'', ''_skmt_original_bytes'', ''_skmt_optimized…'', ''_skmt_bytes_saved'', ''_skmt_main_original…'', ''_skmt_main…'', ''_skmt_main_bytes…'', ''_skmt_optimized…'', \.\.\.\}\}\.$#'
			identifier: return.type
			count: 1
			path: includes/Modules/ImageOptimizer/Module.php

		-
			message: '#^Parameter \#1 \$el of method StudioKyne\\MiniTools\\Modules\\ImageOptimizer\\SvgHandler\:\:clean_attributes\(\) expects DOMElement, DOMNode given\.$#'
			identifier: argument.type
			count: 1
			path: includes/Modules/ImageOptimizer/SvgHandler.php

		-
			message: '#^Parameter \#1 \$el of method StudioKyne\\MiniTools\\Modules\\ImageOptimizer\\SvgHandler\:\:clean_style_element\(\) expects DOMElement, DOMNode given\.$#'
			identifier: argument.type
			count: 1
			path: includes/Modules/ImageOptimizer/SvgHandler.php

		-
			message: '#^Method StudioKyne\\MiniTools\\Modules\\Login\\Module\:\:get_uninstall_keys\(\) should return array\{options\: array\<string\>, meta\: array\<string\>, user_meta\: array\<string\>\} but returns array\{options\: array\{''skmt_module_login''\}, meta\: array\{\}\}\.$#'
			identifier: return.type
			count: 1
			path: includes/Modules/Login/Module.php

		-
			message: '#^Method StudioKyne\\MiniTools\\Modules\\Media\\Module\:\:get_uninstall_keys\(\) should return array\{options\: array\<string\>, meta\: array\<string\>, user_meta\: array\<string\>\} but returns array\{options\: array\{\}, meta\: array\{\}, taxonomy\: array\{''skmt_media_folder''\}\}\.$#'
			identifier: return.type
			count: 1
