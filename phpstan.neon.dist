# Analyse statique. Le niveau est progressif : on le monte quand le niveau courant passe sans baseline.
# L'extension szepeviktor/phpstan-wordpress est chargée automatiquement (phpstan/extension-installer).
# Les gabarits (templates/, settings-template.php) sont inclus depuis une méthode d'Admin : leur
# portée ($this, $tab, $module…) est invisible pour l'analyse, on les laisse à PHPCS.
parameters:
    level: 6
    paths:
        - studio-kyne-mini-tools.php
        - uninstall.php
        - includes
    excludePaths:
        - includes/Modules/*/settings-template.php
    bootstrapFiles:
        - tools/phpstan-bootstrap.php
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: true
